{
  "name": "waygate-web",
  "private": true,
  "version": "1.6.31",
  "type": "module",
  "description": "驿站 · Relay 控制台前端（React 19 + Vite 8 + TypeScript）",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "prebuild": "node ../tools/check-version-sync.mjs && node ../tools/clean-dist.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-note-tokens.mjs && node scripts/check-svg-xml.mjs && node ../tools/check-color-literals.mjs && node ../tools/compare-mock-settings.mjs --check && node ../tools/compare-mock-trend.mjs --check",
    "check:note-tokens": "node scripts/check-note-tokens.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
