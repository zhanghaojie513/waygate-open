# ---------------------------------------------------------------------------
# 驿站 · Relay — 环境变量样例
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，任何真实密钥都不得入库。
# ---------------------------------------------------------------------------

# 出站凭证：你在 WorkBuddy 客户端订阅下创建的自签发密钥（ck_ 开头）。
# 这是本服务转发到 copilot.tencent.com 时使用的唯一凭证。
RELAY_UPSTREAM_KEY=

# HMAC 密钥：用于 client_keys.key_hash 与控制台会话令牌签名。32 字节 hex 建议。
# 丢失后所有 sk-waygate- 密钥的 hash 全部失效，等于全部密钥作废。
RELAY_SECRET=

# 管理口令的 scrypt 哈希（可选，**优先级最高**）。格式 scrypt$N$r$p$<salt_b64>$<hash_b64>
#
# 【四级加载优先级】未设置本变量时，服务按以下顺序找口令：
#   ① 本环境变量（运维显式设定，最高）
#   ② 数据库 admin_credential 表（控制台「设置 → 管理口令 → 重置」写入）
#   ③ 数据目录下的 admin.hash 文件（兼容旧部署；读到后会自动迁进数据库）
#   ④ 都没有 → 生成随机 16 字符口令，打印到 stdout **一次**，写入数据库
#
# 【忘接口令时】进控制台「设置 → 管理口令 → 重置」，或上服务器执行：
#   RELAY_NEW_PASSWORD_CODEPOINTS='[码点…]' node tools/force-set-password.mjs
#   systemctl restart relay        # ★ 直接改库必须重启才生效
RELAY_ADMIN_PASSWORD_HASH=

# 数据目录（默认 ./data）
RELAY_DATA_DIR=

# 监听端口（默认 8787）。生产由 Nginx 反代到本机回环口。
RELAY_PORT=

# 允许监听非回环地址（仅当你明确要把服务暴露到局域网/公网时设为 1）
RELAY_ALLOW_PUBLIC_BIND=

# ---------------------------------------------------------------------------
# CSRF 白名单：额外可信的 Origin（逗号分隔，须写完整 origin，形如
# https://relay.example.com 或 http://localhost:5173）。
#
# 【什么时候需要它】
# 控制台对 POST/PUT/PATCH/DELETE 会校验 Origin 是否等于本站 Host。若请求
# 经过**会改写 Host 头**的反向代理，后端看到的 Host 与浏览器发出的 Origin
# 就不一致 → 登录会被 403 拦下（错误码 40301）。
#
# 【本项目两种情况】
#   生产（Nginx）：配置里用 `proxy_set_header Host $host;` 保留了原 Host，
#                  同源校验直接成立 —— 本变量**留空即可**。
#   本地开发（Vite）：web/vite.config.ts 已设 `changeOrigin: false` 保留
#                  Host，同样无需配置。
#   若你改用其他代理/网关且它硬改写 Host：把控制台对外访问地址填在这里。
#
# 【安全边界】留空是安全的（只接受同源）；填错等于**打开 CSRF 缺口**，
# 因此只填你自己控制的、确定可信的控制台地址，不要填域名后缀或通配。
# ---------------------------------------------------------------------------
RELAY_TRUSTED_ORIGINS=
